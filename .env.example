# ─── Core ────────────────────────────────────────────────────────────────
# Public URL of the app (used for OAuth redirects and same-origin checks).
APP_URL=http://localhost:3000

# SQLite database file. In Docker this lives on the persistent volume.
DATABASE_URL=file:./data/app.db

# Directory for private media storage and temp files (never web-served).
DATA_DIR=./data

# 32-byte key used to encrypt Instagram access tokens at rest (AES-256-GCM).
# REQUIRED in production. Generate with:  openssl rand -hex 32
ENCRYPTION_KEY=

# Set to true when serving over HTTPS (auto-detected from APP_URL if unset).
# COOKIE_SECURE=true

# The first visitor creates the admin account. Set true to allow more sign-ups.
ALLOW_REGISTRATION=false

# Set true only behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY=false

# ─── Instagram API with Instagram Login (optional) ──────────────────────
# From developers.facebook.com → your app → Instagram → API setup with Instagram login.
# Without these, the archive importer and file uploads still work.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Defaults to ${APP_URL}/api/instagram/callback — must match the app dashboard exactly.
# INSTAGRAM_REDIRECT_URI=
INSTAGRAM_GRAPH_VERSION=v23.0

# ─── Limits ──────────────────────────────────────────────────────────────
MAX_DOWNLOAD_MB_CAP=2048
MAX_UPLOAD_MB=1024
MAX_ARCHIVE_UPLOAD_MB=8192
MAX_ARCHIVE_EXTRACTED_MB=16384
MAX_ARCHIVE_ENTRY_MB=2048
MAX_ARCHIVE_ENTRIES=200000

# ─── Maintenance ─────────────────────────────────────────────────────────
CLEANUP_INTERVAL_MINUTES=15
TEMP_FILE_MAX_AGE_HOURS=6

# Path to ffmpeg (Docker image sets /usr/bin/ffmpeg; dev falls back to ffmpeg-static or PATH).
# FFMPEG_PATH=
